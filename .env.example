# Copie este arquivo para .env e preencha com valores reais.
# .env NUNCA deve ser commitado (já está no .gitignore).

# Banco de dados
DB_HOST=localhost
DB_NAME=gestaorevizzi
DB_USER=
DB_PASS=

# Login (usuário único)
AUTH_USER=
# Hash bcrypt (PASSWORD_BCRYPT) com salt aleatório embutido automaticamente pelo PHP.
# Gere com: php -r "echo password_hash('sua-senha', PASSWORD_BCRYPT);"
AUTH_PASS_HASH=

# Segredo usado para assinar o cookie "lembrar-me" (HMAC). Gere com:
# php -r "echo bin2hex(random_bytes(32));"
REMEMBER_SECRET=
